{
  "name": "assaf-v1",
  "version": 1,
  "extends": "base",
  "brand": "assaf",

  "captions": {
    "maxWords": 2
  },

  "motion": {
    "kinds": {
      "doodle": { "fade": { "duration": 0.40, "ease": "power1.inOut" } },
      "image":  { "slide": { "duration": 0.42, "ease": "power3.out" } },
