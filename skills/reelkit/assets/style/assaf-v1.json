{
  "name": "assaf-v1",
  "version": 1,
  "extends": "base",
  "brand": "assaf",
  "captions": {
    "maxWords": 2,
    "strokeWidth": 9,
    "strokeColor": "#05060A",
    "maxDetonations": 3,
    "detonate": {
      "fromScale": 0.62,
      "duration": 0.42,
      "ease": "back.out(2.4)"
    }
  },
  "motion": {
    "kinds": {
      "doodle": {
        "fade": {
          "duration": 0.4,
          "ease": "power1.inOut"
        }
      },
      "image": {
        "slide": {
          "duration": 0.42,
          "ease": "power3.out"
        }
      },
      "hero": {
        "pop": {
          "duration": 0.34,
          "ease": "back.out(2.2)",
          "scale": 0.72
        }
      }
    }
  },
  "pacing": {
    "dwellMin": 2.0,
    "dwellMax": 4.0,
    "severity": "error"
  },
  "audio": {
    "voice": {
      "enabled": true,
      "highpassHz": 80,
      "compressor": {
        "thresholdDb": -18,
        "ratio": 3,
        "attackMs": 5,
        "releaseMs": 120,
        "makeupDb": 2
      },
      "eq": [
        {
          "hz": 220,
          "gainDb": -2,
          "q": 1.0
        },
        {
          "hz": 3200,
          "gainDb": 2,
          "q": 1.0
        }
      ],
      "limiter": {
        "enabled": true,
        "limit": 0.95
      }
    },
    "duck": {
      "enabled": true,
      "threshold": 0.05,
      "ratio": 8,
      "attackMs": 5,
      "releaseMs": 250
    }
  },
  "doodle": {
    "maxMarks": 2,
    "drawSeconds": 0.4,
    "severity": "error"
  },
  "title": {
    "lockup": true,
    "wordStep": 0.085,
    "frameOne": true,
    "scriptFont": "Georgia,'Times New Roman',serif",
    "accentStyle": "marker",
    "highlightColor": "#FFD84D"
  }
}
