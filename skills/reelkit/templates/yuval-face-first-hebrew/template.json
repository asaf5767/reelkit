{
  "name": "yuval-face-first-hebrew",
  "version": 3,
  "lang": "he",
  "caption": {
    "maxWords": 3,
    "maxChars": 15,
    "zone": "lower",
    "plain": true
  },
  "hook": {
    "required": true,
    "zone": "upper",
    "durationSeconds": [
      2,
      5
    ],
    "mayOverlapSpeech": true,
    "selection": "Auto-pick the strongest scroll-stopping title before render. Never block video-in/video-out. Include 2-3 runners-up in the render report so review can request a one-note graphics-plan correction.",
    "qualityBar": [
      "short",
      "tension or curiosity gap",
      "native social phrasing",
      "pattern interrupt",
      "not a documentary summary"
    ],
    "calibration": {
      "acceptedExample": "נתקעתם? אל תשחקו אותה גיבורים",
      "acceptedWhy": [
        "direct address",
        "tension",
        "native pattern interrupt"
      ],
      "rejectedPattern": "lesson-summary titles, even when accurate",
      "rejectedExamples": [
        "מתי להרים דגל?",
        "לא צריך להילחם בשקט",
        "לבקש עזרה זו מיומנות"
      ]
    }
  },
  "rhythm": {
    "faceOnlyTarget": [
      0.65,
      0.8
    ],
    "overlaySeconds": [
      2,
      5
    ],
    "punchScale": [
      1.03,
      1.05
    ]
  },
  "visualLaw": [
    "opening hook text is mandatory and may overlap talking",
    "concrete process before metaphor",
    "whole head clear",
    "graphic silence is pacing",
    "full screen requires literal moving b-roll"
  ],
  "rtl": {
    "native": true,
    "htmlDirAttribute": false
  }
}
